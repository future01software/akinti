  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "storage", "notifications", "activeTab"],
  "homepage_url": "https://github.com/future01software/akinti"
